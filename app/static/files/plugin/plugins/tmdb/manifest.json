                "label": "Include Adult Content",
                "type": "boolean",
                "default": false,
                "category": "Content"
            },
            {
                "key": "append_to_response",
                "label": "Append Metadata",
                "type": "multiselect",
                "default": [
                    "credits",
                    "videos",
                    "similar",
                    "recommendations"
                ],
                "options": [
                    "credits",
                    "videos",
                    "similar",
                    "recommendations",
                    "images",
                    "translations"
                ],
                "category": "Metadata"
            },
            {
                "key": "cache_enabled",
                "label": "Enable Caching",
                "type": "boolean",
                "default": true,
                "category": "Performance"
            },
            {
                "key": "cache_duration",
                "label": "Cache Duration (hours)",
                "type": "number",
                "default": 24,
                "category": "Performance"
            }
        ]
