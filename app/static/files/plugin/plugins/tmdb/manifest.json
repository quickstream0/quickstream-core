{
    "id": "com.quickstream.plugin.tmdb",
    "name": "TMDb",
    "version": "0.0.0",
    "description": "Provides movie and TV show metadata from The Movie Database",
    "language": "javascript",
    "authors": [
        "QuickStream Team"
    ],
    "logoUrl": "assets/tmdb_logo.png",
    "runtime": "fjs",
    "capabilities": [
        "metadata",
        "source",
        "search"
    ],
    "mediaTypes": [
        "Movies",
        "Tv Shows",
        "Anime"
    ],
    "defaultCardOrientation": "portrait",
    "searchHint": "Search for Movies & TV Shows",
    "methods": {
        "home": [
            "getHomeContent"
        ],
        "search": [
            "search"
        ],
        "details": [
            "getDetails"
        ],
        "more": [
            "getMediaItems"
        ],
        "season": [
            "getSeasonEpisodes"
        ],
        "source": [
            "getStreams",
            "getStreamSources"
        ]
    },
    "configurable": true,
    "requireConfiguration": false,
    "configSchema": {
        "fields": [
