{
    "id": "com.quickstream.plugin.dramacool",
    "name": "DramaCool",
    "version": "0.0.0",
    "description": "Asian dramas and K-shows from DramaCool with vidbasic + kisskh server extraction via Open Extractors.",
    "language": "javascript",
    "authors": ["Community"],
    "runtime": "fjs",
    "capabilities": ["metadata", "source", "search"],
    "mediaTypes": [
        "Tv Shows"
    ],
    "defaultCardOrientation": "portrait",
    "searchHint": "Search dramas and shows on DramaCool",
    "methods": {
        "home": ["getHomeContent"],
        "search": ["search"],
        "details": ["getDetails"],
        "more": ["getMediaItems"],
        "season": ["getSeasonEpisodes"],
        "source": ["getStreams", "getStreamSources"]
    },
    "logoUrl": "https://dramacool9.com.ro/favicon.ico",
    "dependencies": [
        {
            "id": "com.quickstream.plugin.open-extractors",
            "version": ">=0.0.0",
            "methods": [
                "extractVidbasic",
                "extractKisskh"
            ]
        }
    ]
}
