      "language": "javascript",
      "authors": ["QuickStream Community"],
      "runtime": "fjs",
      "capabilities": ["metadata", "source"],
      "mediaTypes": ["Sports"],
      "configurable": false,
      "logoUrl": "https://streamed.st/favicon.png",
      "url": "https://www.quickstream.fyi/static/files/plugin/plugins/streamed/streamed.qsp"
    },
    {
