{
  "name": "QuickStream Official Repository",
  "description": "Official plugins for QuickStream",
  "version": 1,
  "author": "QuickStream Team",
  "website": "https://www.quickstream.fyi",
  "plugins": [
    {
      "id": "com.quickstream.plugin.tmdb",
      "name": "TMDb",
      "version": "0.0.0",
      "description": "Provides movie and TV show metadata from The Movie Database",
      "language": "javascript",
      "authors": ["QuickStream Team"],
      "runtime": "fjs",
      "capabilities": ["metadata", "source", "search"],
      "mediaTypes": ["Movies", "Tv Shows", "Anime"],
      "configurable": true,
      "logoUrl": "https://www.quickstream.fyi/static/files/plugin/plugins/tmdb/assets/tmdb_logo.png",
      "url": "https://www.quickstream.fyi/static/files/plugin/plugins/tmdb/tmdb.qsp"
    },
    {
      "id": "com.quickstream.plugin.streamed",
      "name": "Streamed",
